# --- Secrets & API Keys (NEVER commit these) ---
.env
*.env
.env.*

# --- AI Assistant Metadata & Configurations ---
# These contain local agent configurations, skills, and conversation artifacts
.agent/
.claude/
.gemini/
tmpclaude-*

# --- Research Results & Large Outputs ---
# These are large outputs that should be reproduced via scripts, not tracked
\#\#\#\#\#\#\#FINAL_RESULTS/
\#\#\#\#\#\#\#LAST\ ROUND\ MS/
\#\#\#\#\#\#\#PHOTOS\ AND\ MAPS/

# --- Cache & Compiled Files ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]
*$py.class
audit_cache.json

# --- R Environment & Session ---
.Rproj.user/
.Rhistory
*-RBFF.Rhistory
.RData
.Ruserdata
cmdstanr/

# --- Logs & Temporary Files ---
*.log
logs/
_ul
_ul-*
variability_analysis_errors.log

# --- Data Files (reproducible via scripts) ---
*.rds
*.RData
*.xlsx
*.csv
*.png
*.pdf
*.tif
*.tiff
*.nc

# --- Jupyter Notebooks (intermediate development, not final code) ---
*.ipynb
.ipynb_checkpoints/

# --- OS Generated Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE & Editor Files ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Plans Directory (AI-generated implementation plans) ---
plans/

